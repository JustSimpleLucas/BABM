  +bool shortSellingEnabled
  +uint64_t seed
  +ControlParameters control
  +FundamentalistConfig fundamentalist
  +ChartistConfig chartist
  +NoiseTraderConfig noiseTrader
  +BuyAndHoldConfig buyAndHold
