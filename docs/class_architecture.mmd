}

class ForcedBuyInResult {
  +double volume
  +double transactionCosts
}

class DiagnosticsRecorder {
  -SimulationStats stats_
  -Vector~StepDetails~ stepDetails_
  -Vector~AgentSnapshot~ agentSnapshots_
  -Vector~ExternalTradeLedgerRecord~ externalTradeLedger_
  +resetForRun(config_populationSize_market_recordLedger)
  +recordStep(request)
  +completeRun(population)
  +buildResult(config_market) SimulationRunResult
}

class Market {
  -Vector~string~ assetNames_
  -Vector~AssetPriceSeries~ series_
  +configureAssets(assetNames)
  +assetCount() size_t
  +assetLabel(asset) string
  +storeMarketValue(asset_value)
  +storeTrueValue(asset_value)
  +getMarketValues(asset) Vector~double~
  +getTrueValues(asset) Vector~double~
  +calculateMovingAverage(asset_window) double
  +calculateLogReturnStandardDeviation(asset_window) double
  +calculateRSI(asset_period) double
}

class FundamentalValueProcess {
  -RandomEngine randomEngine_
  +generateFundamentalValue(market_asset_parameters) double
  +generateCorrelatedFundamentalValues(market_parameters_rho) Vector~double~
  +generateTrueValues(market_asset_parameters) Vector~double~
}

class LimitOrderBook {
  -Multiset~Order_BidOrderPriority~ bids_
  -Multiset~Order_AskOrderPriority~ asks_
  -size_t nextSequence_
  +submitRestingOrder(order)
  +canMatch(order) bool
  +bestOpposingOrder(order) ConstOrderRef
  +reduceBestOpposingOrder(order_fillQuantity)
  +removeBestOpposingOrder(order)
  +expireOrders(step) size_t
  +cancelStaleOrders(referencePrice_baseProb_sensitivity_random) size_t
  +metrics(depthLevels) LimitOrderBookMetrics
  +restingOrdersSnapshot() LimitOrderBookSnapshot
}

class BidOrderPriority {
  +operator(lhs_rhs) bool
}

class AskOrderPriority {
  +operator(lhs_rhs) bool
}

note for LimitOrderBook "Bids and asks are stored in priority-preserving multisets; matching mutates resting orders only through explicit book methods."

