}

class FundamentalistRiskThresholds {
  +double stopLossThreshold
  +double takeProfitThreshold
}

class FundamentalistStrategy {
  -string assetName_
  -AssetAllocationLine allocationLine_
  -double mispricingThreshold_
  -double stopLossThreshold_
  -double takeProfitThreshold_
  +FundamentalistStrategy(parameters)
  +setRiskThresholds(thresholds)
  +generateOrder(agent_market_step_context) OptionalOrder
}

class ChartistStrategy {
  <<abstract>>
  -string assetName_
  -AssetAllocationLine allocationLine_
  -size_t volatilityWindow_
  -double maxShortWeight_
  +generateOrder(agent_market_step_context) OptionalOrder
  +generateSignal(market) AgentAction
  +forecastExcessReturn(market) double
}

class MomentumChartistStrategy {
  -size_t shortWindow_
  -size_t longWindow_
  -double momentumSignalThreshold_
}

class MeanReversionChartistStrategy {
  -size_t longWindow_
}

class RelativeStrengthIndexChartistStrategy {
  +strategyType() string
}

class BreakoutChartistStrategy {
  -size_t breakoutWindow_
}

class ChartistStrategyFactory {
  +createChartistStrategy(config_allocation_random) UniquePtr~TradingStrategy~
}

class NoiseTraderStrategy {
  -string assetName_
  -double beliefShockStdDev_
  -double orderSizeFraction_
