  +generateNextFundamentals(market_process_config)$ Vector~double~
  +resolvePriceAfterClearing(referencePrice_result)$ PriceFormationResult
  +initializeAgentWealths(population_marketPrice)$
  +refreshAgentWealths(population_marketPrice)$
}

class AgentActivationScheduler {
  +schedule(request_random) Vector~size_t~
}

class OrderCollector {
  +resetForRun()
  +collectOrders(step_activeAgents_population_market_config_random) Vector~Order~
}

class TransactionCosts {
  <<utility>>
  +oneSideCost(price_quantity_rate)$ double
  +grossNotional(price_quantity)$ double
