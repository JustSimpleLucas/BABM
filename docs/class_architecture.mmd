  +generateOrder(parameters) OptionalOrder
}

class BuyAndHoldStrategy {
  -string assetName_
  -double targetRiskyWeight_
  +setTargetRiskyWeight(weight)
  +generateOrder(agent_market_step_context) OptionalOrder
}

class ProspectTheory {
  -double lossAversion_
  -double curvatureForGain_
  -double curvatureForLoss_
  -double referencePoint_
  -size_t scenarioCount_
  +valueFunction(relativeOutcome) double
  +probabilityWeight(probability_domain) double
  +calculateProspectValue(outcomes) double
  +prospectAdjustedReturn(expectedReturn_volatility) double
}

class AssetAllocationLine {
  -double riskAversion_
  -double minRiskyWeight_
