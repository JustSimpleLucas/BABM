class SimulationEngine {
  -SimulationConfig config_
  -Market market_
  -FundamentalValueProcess fundamentalProcess_
  -RandomEngine random_
  -SimulationPopulation population_
  -SocialInfluenceModel socialInfluenceModel_
  -AgentActivationScheduler activationScheduler_
  -OrderCollector orderCollector_
  -MarketClearingEngine marketClearingEngine_
  -RiskControlService riskControlService_
  -DiagnosticsRecorder diagnosticsRecorder_
  +run(progressCallback_recordTradeLedger) SimulationRunResult
  +config() SimulationConfig
}

class SimulationPopulation {
  +Vector~AgentRecord~ records
  +Vector~AgentPointer~ agentsById
}

class AgentRecord {
  +Agent agent
  +string initialStrategyType
  +UniquePtr~TradingStrategy~ currentStrategy
}

class Agent {
  -uint32_t numericalId
  -double cash
  -double stock
  -double wealth
  -double averageEntryPrice
  -double cumulativeTransactionCostsPaid
  -ProspectTheory prospectTheoryPreferences
  -bool prospectTheoryEnabled
  +updateCash(newCash)
  +updateStock(newStock)
  +updateWealth(marketPrice)
  +recordExecutedTrade(side_price_quantity)
  +recordTransactionCost(cost)
  +setSocialProfile(x_y_gamma_stdDev)
  +generateOrder(type_price_quantity) Order
}

class TradingStrategy {
  <<abstract>>
  +strategyType() string
  +generateOrder(agent_market_step_context) OptionalOrder
}

class TradingOrderContext {
  +bool useValuationLimitPrice
  +double socialOpinion
  +double opinionKappa
  +double holdTolerance
