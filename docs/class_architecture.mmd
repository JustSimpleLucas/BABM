  +double maxShortWeight
  +ProspectReferencePointMode referencePointMode
  +size_t referenceMovingAverageWindow
}

class MomentumChartistStrategyParameters {
  +ChartistStrategyParameters commonParameters
  +size_t shortWindow
  +size_t longWindow
