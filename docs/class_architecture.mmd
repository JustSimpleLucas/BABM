}

class PopulationFactory {
  +createPopulation(config_random)$ SimulationPopulation
  +resetRunState(population)$
}

class SocialInfluenceModel {
  -Vector~Vector_SocialNeighbor~ socialNeighbors_
  -Vector~double~ nextOpinionScratch_
  +initialize(population_config_random)
  +prepareForRun(population)
  +updateOpinions(population_config_random)
}

note for SocialInfluenceModel "initialize assigns social profiles, then builds the radius-based neighbour graph with a transient spatial hash."

class MarketProcess {
  +initializeMarket(market_process_config_random)$ MarketInitializationResult
