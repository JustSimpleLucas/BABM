    classDef domain fill:#ffffff,stroke:#cbd5e1,stroke-width:1px,color:#0f172a
    classDef target fill:#f0fdf4,stroke:#4ade80,stroke-width:1px,color:#0f172a
    classDef test fill:#f5f3ff,stroke:#8b5cf6,stroke-width:1px,color:#0f172a

    class root,compiler,metadata,sources cmake
    class includes,buildMetadata,core interface
    class utility,config,market,behavioural,agents,results,simulation,analysis,output,archive,application domain
    class app target
    class modelTests,parsingTests,archiveTests,validationTests,artifactTests test
