flowchart TD
    root["CMakeLists.txt"]
    compiler["cmake/AbmCompilerOptions.cmake"]
    metadata["cmake/AbmBuildMetadata.cmake"]
    sources["src/CMakeLists.txt<br/>+ per-directory target_sources()"]

    includes["abm_project_includes"]
    buildMetadata["abm_build_metadata"]
    core["abm_core compatibility aggregate"]
    app["simulate executable"]

    utility["abm_utility<br/>RandomGenerator, Utility"]
    config["abm_config<br/>Config"]
    market["abm_market<br/>Market, OrderBook, RiskManagement"]
    behavioural["abm_behavioural_finance<br/>ProspectTheory"]
    agents["abm_agents<br/>Agent, AgentStrategy"]
    results["abm_results<br/>completed-run DTOs"]
    simulation["abm_simulation<br/>Simulation engine services"]
    analysis["abm_analysis<br/>stylised-fact metrics"]
    output["abm_output<br/>CSV, JSON, metadata, run logs"]
    archive["abm_archive<br/>DataManagement, Experiment"]
    application["abm_application<br/>CLI, console, Python analysis runner"]

    modelTests["abm_model_tests"]
    parsingTests["abm_config_parsing_tests"]
    archiveTests["abm_archive_workflow_tests"]
    validationTests["abm_config_validation_tests"]
    artifactTests["abm_run_artifact_writer_tests"]

    root --> compiler
    root --> metadata
    root --> sources
    root --> includes
