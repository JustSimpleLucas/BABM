    noteNoPaths["Database records do not store local filesystem paths"]
    runs --> noteNoPaths
    sqlBenchmarks --> noteNoPaths
    audit --> noteNoPaths

    notePrune["Staging artefacts may be pruned after successful import"]
    dbCli --> notePrune
    notePrune --> staging

    noteHashes["Audit records store schema version, importer version, Git commit, and SHA-256 hashes"]
    audit --> noteHashes

    noteCompress["Archived CSVs may be gzipped in place; analysis and import read *.csv.gz transparently"]
    runFolder --> compressCli
    compressCli --> noteCompress
    noteCompress --> runFolder

    noteGuard["Import fails loudly on CSV columns unknown to the schema instead of silently dropping them"]
    dbCli --> noteGuard

    noteJobs["replicate and calibrate fan simulator seeds across --jobs workers; each new run directory is parsed from simulator stdout, never inferred by directory diffing"]
    seedReplication --> noteJobs
    calibrateCli --> noteJobs

    runFolder --> webDashboard
    calibrationDir --> webDashboard
    assetTimeSeries --> webDashboard
    agents --> webDashboard
    optionalLedger --> webDashboard
    optionalProtagonist --> webDashboard
    noteWebReadOnly["web serves statistics recomputed by statistics/diagnostics.py and statistics/multi_asset.py, plus agent outcomes via statistics/agents.py, stress windows via statistics/stress.py, order flow via statistics/order_flow.py, the price line's moving averages via statistics/smoothing.py, and calibration studies via statistics/calibration_study.py; it never simulates and never writes to data/"]
    webDashboard --> noteWebReadOnly
    noteWebAssetGate["web reports per-asset statistics only when asset_timeseries.csv records two or more assets, so an archive whose per-asset artefact disagrees with its step series keeps the single-asset numbers"]
    webDashboard --> noteWebAssetGate

