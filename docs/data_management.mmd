    subgraph cxxProducer["C++ Simulation Data Producer"]
        runtimeConfig["RuntimeConfig"]
        dataWorkflow["ExperimentDataWorkflow"]
        runManager["ExperimentRunManager"]
        artifactWriter["RunArtifactWriter"]
        pythonRunner["PythonAnalysisRunner"]
    end

    subgraph staging["Temporary Staging Artefacts"]
        runFolder["data/experiments/<experiment>/<run_id>/"]
        configSnapshot["config_used.cfg and config.json"]
        metadata["metadata.json with portable provenance"]
        timeSeries["step_timeseries.csv with market, microstructure, allocative-efficiency, and wealth-Gini diagnostics"]
        assetTimeSeries["asset_timeseries.csv long-format per (step, asset) with per-asset prices, microstructure, allocative efficiency, and mean agent portfolio weights"]
        agents["agents_final.csv with the is_protagonist flag"]
        optionalProtagonist["protagonist_timeseries.csv when a protagonist is configured"]
        optionalLedger["trade_ledger.csv when enabled"]
        metrics["summary_metrics.csv with final-wealth Gini, mean allocative efficiency, and the protagonist's standing, and stylised_facts.csv screened per asset"]
    end

    subgraph postgres["PostgreSQL Primary Research Store"]
        experiments["experiments"]
        runs["runs with config and sanitized metadata"]
        sqlTimeSeries["step_timeseries with market, microstructure, allocative-efficiency, and wealth-Gini diagnostics"]
        sqlAssetTimeSeries["asset_timeseries per (step, asset) including allocative efficiency and mean agent portfolio weights"]
        sqlAgents["agent_snapshots"]
        sqlProtagonist["protagonist_timeseries"]
        sqlLedger["trade_ledger"]
        sqlMetrics["summary_metrics with final-wealth Gini and mean allocative efficiency, and per-asset stylised_facts"]
        sqlMechanisms["mechanism and agent-step diagnostics"]
        sqlBenchmarks["benchmark_series, metadata, and prices"]
        audit["schema_migrations and import_audit provenance"]
    end

    subgraph pythonAccess["Python Analysis and Calibration"]
        dbCli["abm_analysis db commands"]
        compressCli["abm_analysis compress in-place gzip of large run CSVs"]
        seedReplication["abm_analysis replicate seed runner"]
        calibrateCli["abm_analysis calibrate Optuna search with seed-averaged scoring and seed-robust candidate validation"]
        seedRobustnessTables["robustness_reports/latest_seed_robustness CSV tables: cross-seed tests, ADF, convergence, and verdicts"]
        holdoutTables["holdout_validation out-of-sample comparison against held-back benchmark series"]
        benchmarkImport["empirical benchmark CSV and manifest import"]
        inspectRun["db inspect-run provenance summary"]
        webDashboard["abm_analysis web read-only local dashboard over data/ with per-asset statistics, agent outcomes, stress windows, order flow from trade_ledger.csv, and calibration studies from calibration_trials.csv"]
    end

    subgraph calibrationStore["Calibration Study Outputs"]
        calibrationDir["data/calibration/<study>/ with trial_configs and simulation_runs"]
        calibrationTrials["calibration_trials.csv appended per trial"]
        calibrationBest["best_config.cfg, candidate ranking, holdout validation, and summary"]
        calibrationTables["calibration_report ranking and best_runs_robustness_report CSV tables"]
    end

