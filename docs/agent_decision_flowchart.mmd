    class nShock noiseClass
    class nSide noiseClass
    class nQuote noiseClass
    class nQuantity noiseClass
    class nClip noiseClass

    class bPrice buyHoldClass
    class bWealth buyHoldClass
    class bTarget buyHoldClass
    class bQuantity buyHoldClass
    class bQuote buyHoldClass

    class createOrder finalClass
    class marketOrder finalClass
    class limitOrder finalClass
    class annotateOrder finalClass

    style collector fill:#f8fbff,stroke:#bfdbfe,stroke-width:1px,color:#0f172a
    style fundamentalist fill:#f7fef9,stroke:#bbf7d0,stroke-width:1px,color:#0f172a
    style chartist fill:#fffaf3,stroke:#fed7aa,stroke-width:1px,color:#0f172a
